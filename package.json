{
  "name": "vibechat",
  "version": "1.0.1",
  "description": "A chill real-time chat room app powered by Firebase, deployed to GitHub Pages.",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "npx serve .",
    "deploy": "git push origin main",
    "electron": "electron .",
    "dist": "node build-desktop.cjs",
    "cap:sync-www": "node scripts/sync-www.cjs",
    "cap:sync": "npm run cap:sync-www && cap sync android"
  },
  "keywords": [
    "chat",
    "firebase",
    "github-pages",
    "realtime"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  }
}
